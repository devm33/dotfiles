#!/usr/bin/env bash

set -euo pipefail

command -v devtunnel >/dev/null 2>&1 || {
  echo "devbox: devtunnel is not installed or not in PATH" >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || {
  echo "devbox: jq is required to read the dev tunnel list" >&2
  exit 1
}

tunnels=()
while IFS= read -r tunnel; do
  [[ -n "$tunnel" ]] && tunnels+=("$tunnel")
done < <(devtunnel list --json | jq -r '.tunnels[]?.tunnelId')

case ${#tunnels[@]} in
  0)
    echo "devbox: no dev tunnels found" >&2
    exit 1
    ;;
  1)
    tunnel=${tunnels[0]}
    ;;
  *)
    echo "Select a dev tunnel:" >&2
    PS3="Tunnel: "
    select tunnel in "${tunnels[@]}"; do
      if [[ -n "$tunnel" ]]; then
        break
      fi
      echo "Invalid selection." >&2
    done
    ;;
esac

log=$(mktemp "${TMPDIR:-/tmp}/devbox.XXXXXX")
tunnel_pid=""

reset_terminal() {
  [[ -t 0 ]] || return 0

  # Remote TUIs cannot restore these modes when the SSH transport disappears.
  printf '\033[?1000l\033[?1002l\033[?1003l\033[?1005l\033[?1006l\033[?1015l' >/dev/tty
  printf '\033[?1004l\033[?2004l\033[?1049l\033[?25h' >/dev/tty
  stty sane </dev/tty 2>/dev/null || true
}

stop_tunnel() {
  if [[ -n "$tunnel_pid" ]]; then
    if kill -0 "$tunnel_pid" 2>/dev/null; then
      kill "$tunnel_pid" 2>/dev/null || true
    fi
    wait "$tunnel_pid" 2>/dev/null || true
  fi
  tunnel_pid=""
}

cleanup() {
  reset_terminal
  stop_tunnel
  rm -f "$log"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

start_tunnel() {
  : >"$log"

  host_connections=$(devtunnel list --json |
    jq -r --arg tunnel "$tunnel" \
      '.tunnels[] | select(.tunnelId == $tunnel) | .hostConnections // 0')
  if [[ -z "$host_connections" ]]; then
    echo "devbox: tunnel no longer exists: $tunnel" >&2
    return 1
  fi
  if [[ "$host_connections" == "0" ]]; then
    echo "devbox: remote tunnel host is offline: $tunnel" >&2
    return 1
  fi

  echo "Connecting to tunnel: $tunnel" >&2
  devtunnel connect "$tunnel" >"$log" 2>&1 &
  tunnel_pid=$!

  port=""
  for attempt in $(seq 1 300); do
    port=$(sed -nE \
      's/.*127\.0\.0\.1:([0-9]+) to host port 22\..*/\1/p' \
      "$log" | head -n 1)

    if [[ -z "$port" ]] && ((attempt % 10 == 0)) && command -v lsof >/dev/null 2>&1; then
      port=$(lsof -nP -a -p "$tunnel_pid" -iTCP -sTCP:LISTEN -Fn 2>/dev/null |
        sed -nE 's/^n(127\.0\.0\.1|\[::1\]):([0-9]+)$/\2/p' |
        head -n 1)
    fi

    [[ -n "$port" ]] && return 0
    kill -0 "$tunnel_pid" 2>/dev/null || break
    sleep 0.1
  done

  echo "devbox: could not determine the forwarded SSH port" >&2
  if [[ -s "$log" ]]; then
    cat "$log" >&2
  else
    echo "devbox: devtunnel produced no diagnostic output" >&2
  fi
  stop_tunnel
  return 1
}

until start_tunnel; do
  echo "devbox: tunnel host unavailable; retrying in 5 seconds (Ctrl-C to stop)" >&2
  sleep 5
done

ssh_options=(
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=3
  -o TCPKeepAlive=yes
)

# A remote command cannot safely be replayed, so only interactive sessions
# reconnect automatically.
if (($# > 0)); then
  if ssh "${ssh_options[@]}" -p "$port" devbox "$@"; then
    exit 0
  else
    exit $?
  fi
fi

while true; do
  echo "Connecting to devbox through localhost:$port" >&2
  if ssh "${ssh_options[@]}" -p "$port" devbox; then
    exit 0
  fi
  reset_terminal

  echo "devbox: SSH disconnected; restarting tunnel in 3 seconds (Ctrl-C to stop)" >&2
  sleep 3

  stop_tunnel
  until start_tunnel; do
    echo "devbox: tunnel unavailable; retrying in 5 seconds" >&2
    sleep 5
  done
done
